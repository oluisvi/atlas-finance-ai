{
  "name": "atlas-finance-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.build.json",
    "start:api": "npm run build:api && node dist/apps/api/src/main.js",
    "start:api:prod": "node dist/apps/api/src/main.js",
    "start:web:prod": "npm --prefix apps/web run start:prod",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "typecheck:api": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run lint:api && npm --prefix apps/web run lint",
    "lint:api": "eslint apps/api prisma.config.ts",
    "test": "npm run test:api && npm run test:web",
    "test:api": "jest --runInBand --testPathIgnorePatterns=apps/web",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "db:verify-catalog": "node scripts/verify-supabase-catalog.mjs",
    "db:expected-catalog": "node scripts/expected-catalog-from-migration.mjs",
    "setup:env": "node scripts/setup-env.mjs"
    ,"dev:web": "npm --prefix apps/web run dev"
    ,"build:web": "npm --prefix apps/web run build"
    ,"test:web": "npm --prefix apps/web run test"
    ,"typecheck:web": "npm --prefix apps/web run typecheck"
    ,"api:generate": "tsx scripts/generate-openapi.mts && npm --prefix apps/web run api:generate"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^17.2.3",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "4.3.1"
    }
  }
}
