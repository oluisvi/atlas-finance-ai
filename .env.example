# Atlas Finance AI - Environment Variables
# Copy this file to .env and replace every placeholder with real secret values.
# Never commit .env or real credentials.

# ---------------------------------------------------------------------------
# Application runtime
# ---------------------------------------------------------------------------
NODE_ENV="development"
API_PORT="3000"
API_PREFIX="api"
API_VERSION="1"

# Comma-separated origins. Empty means permissive CORS outside production.
# Example: CORS_ORIGIN="http://localhost:3001,https://app.example.com"
CORS_ORIGIN=""

# ---------------------------------------------------------------------------
# Supabase project metadata
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_REF="mzqipbkktbpdcasfvzny"
SUPABASE_URL="https://mzqipbkktbpdcasfvzny.supabase.co"

# ---------------------------------------------------------------------------
# DATABASE_URL - runtime NestJS connection through Supabase Transaction Pooler
# ---------------------------------------------------------------------------
# Used by:
# - NestJS API
# - Prisma Client runtime with @prisma/adapter-pg
#
# Do not use this URL for Prisma migrations, introspection or catalog checks.
#
# Get it from:
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# -> Transaction pooler -> URI
#
# Required params for runtime pooler:
# - pgbouncer=true
# - connection_limit=1
# - sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Optional runtime pool size for the Node pg pool used by Prisma adapter.
DATABASE_POOL_MAX="10"

# ---------------------------------------------------------------------------
# DIRECT_URL - administrative direct connection to Supabase PostgreSQL
# ---------------------------------------------------------------------------
# Used by:
# - prisma migrate deploy
# - prisma db pull
# - npm run db:verify-catalog
#
# The NestJS API does not use DIRECT_URL at runtime.
#
# Get it from:
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# -> Direct connection -> URI
#
# Required param:
# - sslmode=require
DIRECT_URL="postgresql://USER:PASSWORD@db.mzqipbkktbpdcasfvzny.supabase.co:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Future modules - keep placeholders only
# ---------------------------------------------------------------------------
# Authentication will be implemented by NestJS, not Supabase Auth.
JWT_ACCESS_SECRET="replace-with-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-strong-random-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
JWT_ISSUER="atlas-finance-ai"
JWT_AUDIENCE="atlas-finance-ai"

# Redis is planned for cache, queues, locks and rate limiting.
REDIS_URL="redis://localhost:6379"

# FastAPI/OpenAI are planned for the AI insights service, not Supabase Edge Functions.
AI_SERVICE_URL="http://localhost:8000"
OPENAI_API_KEY="replace-with-openai-api-key"
